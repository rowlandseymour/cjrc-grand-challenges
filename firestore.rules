rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Workshop collections: anyone can read and write during the workshop window.
    // For a one-day event this is appropriate. After the workshop, change `allow write` to `false`
    // to lock the data, or delete the project entirely.

    match /edits/{questionId} {
      allow read: if true;
      allow write: if request.time < timestamp.date(2026, 12, 31)
                   && request.resource.data.text is string
                   && request.resource.data.text.size() < 5000
                   && request.resource.data.by is string
                   && request.resource.data.by.size() < 200;
      allow delete: if request.time < timestamp.date(2026, 12, 31);
    }

    match /revivals/{groupId} {
      allow read: if true;
      allow write: if request.time < timestamp.date(2026, 12, 31)
                   && request.resource.data.ids is list
                   && request.resource.data.ids.size() <= 3;
    }

    match /themes/{questionId} {
      allow read: if true;
      allow write: if request.time < timestamp.date(2026, 12, 31)
                   && request.resource.data.theme is string
                   && request.resource.data.theme.size() < 200;
      allow delete: if request.time < timestamp.date(2026, 12, 31);
    }

    match /cuts/{questionId} {
      allow read: if true;
      allow write: if request.time < timestamp.date(2026, 12, 31)
                   && request.resource.data.by is string;
      allow delete: if request.time < timestamp.date(2026, 12, 31);
    }
  }
}
